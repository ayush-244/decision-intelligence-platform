# =============================================================================
# Delphi — Environment Template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your environment.
#   cp .env.example .env
#
# NEVER commit a real `.env`. Only this template is version-controlled.
# docker-compose reads this file; the backend loads it via pydantic-settings.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# One of: development | staging | production
DELPHI_ENVIRONMENT=development
# Human-readable service name used in logs and API metadata.
DELPHI_APP_NAME=Decision Intelligence Platform
# Toggle verbose debug behaviour (interactive docs, tracebacks). Never true in prod.
DELPHI_DEBUG=true
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
DELPHI_LOG_LEVEL=INFO
# Log rendering: "json" for machine ingestion, "console" for local readability.
DELPHI_LOG_FORMAT=console

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
DELPHI_HOST=0.0.0.0
DELPHI_PORT=8000
# Comma-separated list of allowed CORS origins (frontend URLs).
DELPHI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=delphi
POSTGRES_PASSWORD=delphi_dev_password_change_me
POSTGRES_DB=delphi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy async DSN. In docker-compose POSTGRES_HOST becomes the service name `postgres`.
DELPHI_DATABASE_URL=postgresql+asyncpg://delphi:delphi_dev_password_change_me@localhost:5432/delphi

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# In docker-compose REDIS_HOST becomes the service name `redis`.
DELPHI_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication (Phase 2)
# -----------------------------------------------------------------------------
DELPHI_JWT_SECRET_KEY=dev_jwt_secret_change_me_in_production
DELPHI_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
DELPHI_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DELPHI_REFRESH_TOKEN_COOKIE_NAME=delphi_refresh_token
DELPHI_AUTH_RATE_LIMIT=10/minute

# -----------------------------------------------------------------------------
# Dataset storage (Phase 3)
# -----------------------------------------------------------------------------
DELPHI_STORAGE_BASE_PATH=./data/storage
DELPHI_MAX_UPLOAD_SIZE_BYTES=104857600
DELPHI_PREVIEW_ROW_LIMIT=50

# -----------------------------------------------------------------------------
# AI Decision Copilot (Phase 13)
# -----------------------------------------------------------------------------
DELPHI_LLM_PROVIDER=mock
DELPHI_LLM_MODEL=gpt-4o-mini
DELPHI_LLM_BASE_URL=https://api.openai.com/v1
# DELPHI_OPENAI_API_KEY=sk-...
DELPHI_COPILOT_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# Frontend (Vite) — variables MUST be prefixed with VITE_ to be exposed.
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Delphi
